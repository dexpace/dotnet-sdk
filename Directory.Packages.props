<Project>

  <!-- Single source of truth for dependency versions (the libs.versions.toml analog).
       Projects reference packages WITHOUT a Version attribute. -->
  <PropertyGroup>
    <!-- A PackageVersion below also pins the package when it arrives transitively, so a transitive package whose
         version matters is fixed here rather than floating with whatever a direct dependency asks for (design
         §2.3). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- The runtime band of the SDK pinned in global.json. The SDK's implicit toolchain packs (the trimmer pack
         of IsTrimmable libraries) are pinned to it in Directory.Build.targets, so the lock files do not move
         with the SDK patch. Move it with global.json. -->
    <DexpaceToolchainPackVersion>10.0.12</DexpaceToolchainPackVersion>
  </PropertyGroup>

  <ItemGroup Label="Runtime">
    <!-- The one runtime dependency core may take (roadmap constraint 2, design §2.4), band-matched to the
         net10.0 target: its 10.0.x net10.0 group resolves System.Diagnostics.DiagnosticSource to the in-box
         assembly instead of a package copy. scripts/ci/dependency-audit.cs enforces the band. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Build-only analyzers (PrivateAssets=all)">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.290" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xUnit v3 on Microsoft.Testing.Platform v2 (styleguide 11.1, design §9.3): each test project is its own
         executable, and `dotnet test` runs in the platform's mode (global.json "test.runner"). The 4.x package
         carries the MTP v2 integration. Test-only: nothing here reaches a library's closure. -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- NFR-5's collector on the platform: coverlet's MTP extension writes the same Cobertura report that
         scripts/ci/coverage-gate.cs merges. -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <!-- The TRX report (report-trx option), for the per-OS test-results artifact CI uploads. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <!-- The FakeTimeProvider of styleguide 11.6, re-exported to every suite by Dexpace.Sdk.TestSupport. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>

</Project>
