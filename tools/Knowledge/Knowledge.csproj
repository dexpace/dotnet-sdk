<Project Sdk="Microsoft.NET.Sdk">

  <!-- The knowledge-corpus query CLI and its two companions (verify-structure, drift): a repository
       tool, never shipped. It inherits the root Directory.Build.props, so the analyzer gate applies
       here exactly as it does to the libraries. BCL-only on purpose, like the Ruby original. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dexpace.Tools.Knowledge</RootNamespace>
    <AssemblyName>knowledge</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Knowledge.Tests" />
  </ItemGroup>

</Project>
