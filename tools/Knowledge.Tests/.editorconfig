#
# The root .editorconfig scopes its test exemptions to tests/**; this tool's tests live under tools/, so
# the same exemption is restated here rather than widened at the root.

[*.cs]
# Test method names use Pascal_Snake casing by convention (Method_DoesThing_WhenCondition), as in tests/.
dotnet_diagnostic.CA1707.severity = none
