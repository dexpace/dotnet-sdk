<Project>

  <!-- One source of truth for every project in the repository, including the tools solution
       (docs/styleguide/csharp/01-formatting-and-tooling.md 1.1). A leaf .csproj carries only its own
       identity, references and genuine per-project exceptions; it never restates a property set here. -->

  <PropertyGroup Label="Target framework">
    <!-- Roadmap decision D1 (approved 2026-09-28): the floor is net10.0 only, for libraries and tests alike.
         Raising or widening it is this one edit, plus the CI runtime matrix. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Compiler">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Usings are explicit: each project commits a GlobalUsings.cs with its curated set, and every other
         dependency is visible at the top of the file that takes it (styleguide 1.5, 12.7; design §9.4). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <!-- Meziantou.Analyzer is referenced for MA0051 (the 70-line method cap, styleguide 1.7) only. Every other
         MA rule starts at `none`; .editorconfig turns MA0051 on. Adopting another MA rule is an .editorconfig
         edit with its own rationale, never a change of this mode. -->
    <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <PropertyGroup Label="Dependencies">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Audit transitive packages too, not only direct ones. Set explicitly so the audit does not depend on the
         target framework's default. Advisories fail the build under TreatWarningsAsErrors; fix them, never
         suppress them (design §9). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Every project commits a packages.lock.json, and CI restores in locked mode, so the dependency graph cannot
         move without a reviewed diff (styleguide 1.6; design §9, "Formatting and lock files"). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Libraries are the projects under src/. They alone carry the trim/AOT analyzers, the public-API snapshot,
       the banned-API list and package validation. Decided by location rather than by IsPackable, because a
       leaf project's IsPackable is not yet visible when this file is evaluated. -->
  <PropertyGroup>
    <DexpaceIsLibrary Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('src$([System.IO.Path]::DirectorySeparatorChar)'))">true</DexpaceIsLibrary>
  </PropertyGroup>

  <!-- NFR-16's strong-naming half (phase 12, P12-9, P12-10; design §9.2). Strong naming is an assembly identity, not a security measure on .NET:
       it exists so a strong-named consumer does not meet CS8002 against an unsigned library, and it must be decided before 0.1.0 because adding a
       strong name afterwards changes every assembly's identity. Dexpace.Sdk.snk is committed on purpose (the key is public by design; nothing trusts it).
       It is a 2048-bit RSA key in the CALG_RSA_SIGN blob layout; a key exported as CALG_RSA_KEYX gives CS0281, and the .NET SDK has no cross-platform `sn -p`,
       so DexpacePublicKey (the hex of the public key blob: 00240000 04800000, the blob length, then the PUBLICKEYBLOB) is the one place the public half is
       written, and every library's InternalsVisibleTo reads it as Key="$(DexpacePublicKey)" (CS1726 otherwise, as a signed friend needs a keyed grant).
       The public key token is fb3fcc3028a3989e; StrongNameKeyTests pins the property against each built library and pins this token as a literal, so a key rotation is a visible test edit.
       Signing is scoped to src/ and tests/ by path (the friend test assemblies must be signed). The tools solution and the housekeeping skill stay
       unsigned: they are not packed and their InternalsVisibleTo items are keyless, so signing them would break their friend tests with CS1726.
       AssemblyVersion stays the SDK default (Major.Minor.Patch.0 from VersionPrefix): on net10.0 there are no binding redirects to feed. -->
  <PropertyGroup Label="Strong naming">
    <DexpacePublicKey></DexpacePublicKey>
  </PropertyGroup>

  <PropertyGroup>
    <DexpaceRelativeProjectDirectory>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</DexpaceRelativeProjectDirectory>
    <DexpaceIsSigned Condition="$(DexpaceRelativeProjectDirectory.StartsWith('src$([System.IO.Path]::DirectorySeparatorChar)')) Or $(DexpaceRelativeProjectDirectory.StartsWith('tests$([System.IO.Path]::DirectorySeparatorChar)'))">true</DexpaceIsSigned>
  </PropertyGroup>

  <PropertyGroup Label="Strong naming" Condition="'$(DexpaceIsSigned)' == 'true'">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Dexpace.Sdk.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Label="Library gates" Condition="'$(DexpaceIsLibrary)' == 'true'">
    <!-- NFR-8/NFR-9: the trim, single-file and AOT analyzers run at the library's own build (design §9.2). -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- NFR-4's binary half. No PackageValidationBaselineVersion until the first published version (phase 12);
         until then it checks the package's own consistency. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- NFR-12 (phase 12, P12-11): a .snupkg beside every .nupkg, for nuget.org's symbol server. The portable PDB is deterministic and carries
         the embedded source links (EmbedUntrackedSources, PublishRepositoryUrl); reproducible-pack.sh compares the .snupkg bytes across two
         checkouts, and its self-test flips a byte in one. The audits read .nupkg only. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Label="Library gates" Condition="'$(DexpaceIsLibrary)' == 'true'">
    <!-- NFR-3/NFR-4: RS0016/RS0017 against the PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt beside each
         project file, which the package's own build props pick up. Shipped stays empty until the first release
         (phase 12); every public surface change until then is a reviewed Unshipped diff (roadmap constraint 8). -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- RS0030 against the repository's BannedSymbols.txt (design §9.1). -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <PropertyGroup Label="Package metadata">
    <!-- The next version is 0.1.0 (phase 12, P12-7; docs/first-release.md proposes it: a first release that adds assertions is at least a minor
         version). The alpha.1 suffix stays on main until the held release commit empties it, and the release preflight holds the version train
         (one version across the five packages, a v-tag equal to it). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Authors>dexpace</Authors>
    <Company>dexpace</Company>
    <Copyright>Copyright (c) 2026 dexpace and Omar Aljarrah</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dexpace/dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dexpace/dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="CI" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
