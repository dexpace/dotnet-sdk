<Project Sdk="Microsoft.NET.Sdk">

  <!-- The housekeeping skill's tooling: a hand-run console tool, not a shipped package. It inherits
       the repository's Directory.Build.props (warnings-as-errors, latest-recommended analyzers,
       code style in build) and Directory.Packages.props, and references no package at all: the
       BCL covers process spawning, regular expressions and JSON. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Housekeeping</RootNamespace>
    <AssemblyName>Housekeeping</AssemblyName>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Housekeeping.Tests" />
  </ItemGroup>

</Project>
