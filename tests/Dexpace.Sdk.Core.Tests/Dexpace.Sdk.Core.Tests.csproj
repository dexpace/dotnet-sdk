<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core's suite (design §2.3): references Dexpace.Sdk.Core and the in-memory fakes of Dexpace.Sdk.TestSupport,
       and never a transport or serializer adapter. SEAM-2's conformance clause is only structurally true while
       this project compiles without one; Architecture/Seam2ArchitectureTests.cs enforces it. -->
  <PropertyGroup>
    <RootNamespace>Dexpace.Sdk.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests are exempt from the strict documentation gate. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared test vectors (roadmap constraint 10): tests/vectors/** is copied beside the test assembly. -->
    <None Include="..\vectors\**\*.json" Link="vectors\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dexpace.Sdk.Core\Dexpace.Sdk.Core.csproj" />
    <ProjectReference Include="..\Dexpace.Sdk.TestSupport\Dexpace.Sdk.TestSupport.csproj" />
    <!-- The conformance kit, for the invariant suite's core driver (phase 10, P10-5). It references core alone, so it brings no transport and no
         codec; SEAM-2's allow-list admits it by name, and the build-graph test keeps failing on any Dexpace.Sdk.Http.* or Dexpace.Sdk.Serialization.*. -->
    <ProjectReference Include="..\..\src\Dexpace.Sdk.Conformance\Dexpace.Sdk.Conformance.csproj" />
  </ItemGroup>

</Project>
