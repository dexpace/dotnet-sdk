{
  "source": "nodejs-sdk@54aeed4 packages/core/src/config/proxy.test.ts (URL layer); ruby-sdk phase 5a design (resolution case list); design 5a P5a-15, R6 to R8. layer=url: the single HTTPS_PROXY value through the URL grammar; layer=selection: variable choice, CGI guard and NO_PROXY.",
  "cases": [
    {
      "name": "https scheme is invalid",
      "layer": "url",
      "env": {
        "HTTPS_PROXY": "https://secure.example.com:9090"
      },
      "expected": null,
      "warning": {
        "variable": "HTTPS_PROXY",
        "reason": "scheme"
      },
      "note": "Node accepts https as a proxy scheme; the design rejects it rather than silently downgrade (P5a-15 item 3)"
    },
    {
      "name": "http",
      "layer": "url",
      "env": {
        "HTTPS_PROXY": "http://proxy.example.com:8080"
      },
      "expected": {
        "type": "Http",
        "host": "proxy.example.com",
        "port": 8080,
        "userName": null,
        "password": null,
        "nonProxyHosts": []
      },
      "warning": null
    },
    {
      "name": "scheme is case-insensitive, host kept as written",
      "layer": "url",
      "env": {
        "HTTPS_PROXY": "HTTP://Proxy.Example.com:8080"
      },
      "expected": {
        "type": "Http",
        "host": "Proxy.Example.com",
        "port": 8080,
        "userName": null,
        "password": null,
        "nonProxyHosts": []
      },
      "warning": null
    },
    {
      "name": "socks5",
      "layer": "url",
      "env": {
        "HTTPS_PROXY": "socks5://proxy.example.com:1080"
      },
      "expected": {
        "type": "Socks5",
        "host": "proxy.example.com",
        "port": 1080,
        "userName": null,
        "password": null,
        "nonProxyHosts": []
      },
      "warning": null
    },
    {
