    { "op": "parse", "input": "text/plain;boundary=\"a;b=c\"", "type": "text", "subtype": "plain", "parameters": { "boundary": "a;b=c" } },
    { "op": "parse", "input": "text/plain;", "type": "text", "subtype": "plain", "parameters": {} },
    { "op": "parse", "input": "text/plain ; a=b ; c=d", "type": "text", "subtype": "plain", "parameters": { "a": "b", "c": "d" } },
    { "op": "parse", "input": "multipart/form-data; boundary=\"a b\"", "type": "multipart", "subtype": "form-data", "parameters": { "boundary": "a b" } },
    { "op": "parse", "input": "text/plain;a=\"\"", "type": "text", "subtype": "plain", "parameters": { "a": "" } },
    { "op": "parse", "input": "*/*", "type": "*", "subtype": "*", "parameters": {} },
    { "op": "parse", "input": "application/*", "type": "application", "subtype": "*", "parameters": {} },

    { "op": "reject", "input": "" },
