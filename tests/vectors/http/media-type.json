    { "op": "roundtrip", "type": "text", "subtype": "plain", "parameters": { "x": "" } },
    { "op": "roundtrip", "type": "application", "subtype": "json", "parameters": {} },
    { "op": "roundtrip", "type": "text", "subtype": "plain", "parameters": { "charset": "utf-8", "q": "0.5" } }
