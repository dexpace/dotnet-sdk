   "headers": {
    "Retry-After": ".5"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
   "name": "Retry-After '5.' is no hint",
   "headers": {
    "Retry-After": "5."
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
   "name": "Retry-After '1,5' is no hint",
   "headers": {
    "Retry-After": "1,5"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
