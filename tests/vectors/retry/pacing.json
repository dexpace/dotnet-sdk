    "X-RateLimit-Reset": "1767225699"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 300000000
  },
  {
   "name": "X-RateLimit-Reset epoch delta",
   "headers": {
    "X-RateLimit-Reset": "1767225610"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 100000000
  },
  {
   "name": "X-RateLimit-Reset adds up to 20 percent at u=1",
