{
 "source": "nodejs-sdk@54aeed4 packages/core/src/retry/pacing.test.ts (plus ruby-sdk@5b17395 gems/dexpace-core/test/dexpace/resilience/policy_test.rb pacing cases and java-sdk RetryAfterParser cases)",
 "note": "Each case calls RetryPacing.TryGetHint(headers, now, () => u) with now = 2026-01-01T00:00:00Z plus nowOffsetSeconds. expectedTicks is in 100 ns ticks; null means no hint. Cases that assert a host fact of Node or Ruby (Number() reading an exponent, Float() reading underscores) are not ported (roadmap constraint 10). Where .NET differs from the sibling a note names the ruling.",
 "cases": [
  {
   "name": "Retry-After integer seconds",
   "headers": {
    "Retry-After": "30"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 300000000
  },
  {
   "name": "Retry-After fractional seconds",
   "headers": {
    "Retry-After": "1.5"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 15000000
  },
  {
   "name": "Retry-After zero",
   "headers": {
    "Retry-After": "0"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 0
  },
  {
   "name": "Retry-After http-date",
   "headers": {
    "Retry-After": "Thu, 01 Jan 2026 00:00:10 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 100000000
  },
  {
   "name": "Retry-After http-date single-digit day",
   "headers": {
    "Retry-After": "Thu, 1 Jan 2026 00:00:10 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 100000000
  },
  {
   "name": "Retry-After http-date wrong weekday is ignored",
   "headers": {
    "Retry-After": "Mon, 01 Jan 2026 00:00:10 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 100000000
  },
  {
   "name": "Retry-After past http-date is zero",
   "headers": {
    "Retry-After": "Thu, 01 Jan 2026 00:00:00 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 5,
   "expectedTicks": 0
  },
  {
   "name": "Retry-After year 0026 is a valid past instant",
   "headers": {
    "Retry-After": "Thu, 01 Jan 0026 00:00:00 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 0
  },
  {
   "name": "Retry-After day 32 is no hint",
   "headers": {
    "Retry-After": "Thu, 32 Jan 2026 00:00:10 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
   "name": "Retry-After hour 24 is no hint",
   "headers": {
    "Retry-After": "Thu, 01 Jan 2026 24:00:10 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
   "name": "Retry-After unknown month is no hint",
   "headers": {
    "Retry-After": "Thu, 01 Foo 2026 00:00:10 GMT"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
   "name": "Retry-After '30d' is no hint",
   "headers": {
    "Retry-After": "30d"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
   "name": "Retry-After '30f' is no hint",
   "headers": {
    "Retry-After": "30f"
   },
