  },
  {
   "name": "Retry-After padded with spaces is trimmed",
   "headers": {
    "Retry-After": " 30 "
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 300000000,
   "note": "Node rejects a padded value; RFC 9110 field values are trimmed of SP and HTAB, so .NET reads it (P6a-18)."
  },
  {
   "name": "Retry-After with an interior space is no hint",
