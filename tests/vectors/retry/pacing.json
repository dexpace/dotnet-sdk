   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 315360000000000
  },
  {
   "name": "Retry-After int.MaxValue saturates",
   "headers": {
    "Retry-After": "2147483647"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 315360000000000
  },
  {
   "name": "Retry-After 60 days is kept",
   "headers": {
    "Retry-After": "5184000"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 51840000000000
  },
  {
   "name": "retry-after-ms honoured",
   "headers": {
    "retry-after-ms": "250"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 2500000
  },
  {
   "name": "x-ms-retry-after-ms honoured",
   "headers": {
    "x-ms-retry-after-ms": "250"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 2500000
  },
  {
   "name": "retry-after-ms fractional is no hint",
   "headers": {
    "retry-after-ms": "25.5"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": null
  },
  {
   "name": "retry-after-ms precedes x-ms-retry-after-ms",
   "headers": {
    "retry-after-ms": "250",
    "x-ms-retry-after-ms": "999"
   },
   "u": 0.0,
   "nowOffsetSeconds": 0,
   "expectedTicks": 2500000
  },
  {
   "name": "a malformed Retry-After falls through to retry-after-ms",
   "headers": {
